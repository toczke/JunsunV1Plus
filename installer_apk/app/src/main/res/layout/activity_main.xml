<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#121212">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Topway TS8667 / Junsun V1 Plus Partition Flasher"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_adb_wifi"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="ADB over Wi-Fi"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#006699" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_root_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Checking root permissions..."
        android:textColor="#FFBB33"
        android:textSize="13sp"
        android:layout_marginTop="4dp" />

    <!-- Action Buttons Grid: Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:weightSum="3">

        <Button
            android:id="@+id/btn_flash_magisk"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Flash Root (boot.img)"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1B5E20"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_flash_twrp"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Flash TWRP (recovery.img)"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0D47A1"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_reboot_recovery"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Reboot Recovery (ffup)"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#E65100" />
    </LinearLayout>

    <!-- Action Buttons Grid: Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:weightSum="3">

        <Button
            android:id="@+id/btn_backup"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Backup Partitions"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#37474F"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_restore_stock"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Restore Stock Boot/Recovery"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4E342E"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_reboot_system"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Reboot System"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#B71C1C" />
    </LinearLayout>

    <!-- Detection Info -->
    <TextView
        android:id="@+id/tv_file_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scanning external storage for images..."
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:layout_marginTop="8dp" />

    <!-- Terminal Logs -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:background="#000000"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_logs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:text="[System initialized. Ready for operations.]\n" />
    </ScrollView>

</LinearLayout>
