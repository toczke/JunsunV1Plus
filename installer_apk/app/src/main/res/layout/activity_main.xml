<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#121212">

    <!-- Title and Subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Junsun V1 Plus / Topway TS8667 Flasher"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_root_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sprawdzanie luki ffsu..."
        android:textColor="#FFBB33"
        android:textSize="16sp"
        android:layout_marginTop="6dp" />

    <!-- Button Row for Landscape 1280x720 Screen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:weightSum="3">

        <Button
            android:id="@+id/btn_backup"
            android:layout_width="0dp"
            android:layout_height="65dp"
            android:layout_weight="1"
            android:text="1. Kopia Recovery (Backup)"
            android:textSize="14sp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_flash"
            android:layout_width="0dp"
            android:layout_height="65dp"
            android:layout_weight="1"
            android:text="2. Wgraj TWRP (Flash)"
            android:textSize="14sp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_reboot_recovery"
            android:layout_width="0dp"
            android:layout_height="65dp"
            android:layout_weight="1"
            android:text="3. Uruchom w TWRP"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Path Selector / Status info -->
    <TextView
        android:id="@+id/tv_file_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wymagany plik: /sdcard/twrp.img lub z pendrive'a USB"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:layout_marginTop="12dp" />

    <!-- Real-time Terminal Log View -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:background="#000000"
        android:padding="10dp">

        <TextView
            android:id="@+id/tv_logs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#00FF00"
            android:textSize="13sp"
            android:text="[System gotowy do działania]\n" />
    </ScrollView>

</LinearLayout>
