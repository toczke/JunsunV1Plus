#!/sbin/sh
# ==============================================================================
# Topway TS8667 / Junsun V1 Plus - Hardened Android 13 AOSP Custom ROM Flasher
# Safe TWRP update-binary with Device Check & Capacity Validation Gates
# ==============================================================================

OUTFD=$2
ZIPFILE=$3

MIN_REQUIRED_BYTES=1932644352 # Exact uncompressed byte size of AOSP 13 GSI system.img
EXPECTED_SHA256="78076a0e5154b2198db65a5a57f73cde201622441daa7678f5e53d80aae8938b"

ui_print() {
    if [ -n "$OUTFD" ]; then
        echo "ui_print $1" >&$OUTFD
        echo "ui_print" >&$OUTFD
    else
        echo "$1"
    fi
}

set_progress() {
    if [ -n "$OUTFD" ]; then
        echo "set_progress $1" >&$OUTFD
    fi
}

ui_print "====================================================="
ui_print " Topway TS8667 / Junsun V1 Plus (Helio P65 MT6768)  "
ui_print "     Hardened Android 13 AOSP Custom ROM Flasher    "
ui_print "====================================================="

set_progress 0.05

# ------------------------------------------------------------------------------
# GATE 1: Hardware & Board Target Verification
# ------------------------------------------------------------------------------
ui_print "- Checking target hardware compatibility..."
BOARD=$(getprop ro.product.board 2>/dev/null || true)
HARDWARE=$(getprop ro.hardware 2>/dev/null || true)
MODEL=$(getprop ro.product.model 2>/dev/null || true)

ui_print "  Detected Board: $BOARD, Hardware: $HARDWARE, Model: $MODEL"

VALID_TARGET=0
case "$BOARD" in
    *8667*|*mt6768*|*spm8667*) VALID_TARGET=1 ;;
esac
case "$HARDWARE" in
    *mt6768*|*8667*) VALID_TARGET=1 ;;
esac

if [ "$VALID_TARGET" -eq 0 ]; then
    # Secondary check via /proc/cpuinfo
    if grep -Eqi "MT6768|MT8667" /proc/cpuinfo 2>/dev/null; then
        VALID_TARGET=1
    fi
fi

if [ "$VALID_TARGET" -eq 0 ]; then
    ui_print "[-] ERROR: Incompatible hardware! This package is exclusively"
    ui_print "    for Topway TS8667 / MediaTek MT6768 (Helio P65) platforms."
    ui_print "    Aborting without modifying storage."
    exit 1
fi
ui_print "[✓] Hardware platform verified: MediaTek TS8667 compatible."
set_progress 0.10

# ------------------------------------------------------------------------------
# GATE 2: Multi-Factor Partition Topology & Target Device Verification
# ------------------------------------------------------------------------------
ui_print "- Analyzing physical partition topology and dynamic mapper..."
umount /system 2>/dev/null || true
umount /system_root 2>/dev/null || true
umount /tmp/sys_mnt 2>/dev/null || true

# 1. Verify presence of physical super partition container
SUPER_DEV=""
for sdev in /dev/block/by-name/super /dev/block/platform/bootdevice/by-name/super /dev/block/platform/*/by-name/super; do
    if [ -b "$sdev" ]; then
        SUPER_DEV="$sdev"
        break
    fi
done

if [ -z "$SUPER_DEV" ]; then
    ui_print "[-] ERROR: Physical 'super' container partition not found!"
    ui_print "    Target device does not appear to use Android Dynamic Partitions."
    ui_print "    Aborting without modifying physical storage."
    exit 1
fi
ui_print "[✓] Found dynamic partition container: $SUPER_DEV"

# 2. Check slot status from bootloader properties & partition names with strict multi-factor validation
SLOT=$(getprop ro.boot.slot_suffix 2>/dev/null || true)
case "$SLOT" in
    ""|"_a"|"_b")
        # Valid standard slot suffix
        ;;
    *)
        ui_print "[-] ERROR: Malformed or unexpected slot suffix: '$SLOT'"
        ui_print "    Aborting before modifying physical eMMC storage."
        exit 1
        ;;
esac

HAS_SLOT_A=0
HAS_SLOT_B=0
HAS_SYSTEM_PLAIN=0
if [ -b /dev/block/by-name/system_a ] || [ -b /dev/block/mapper/system_a ]; then
    HAS_SLOT_A=1
fi
if [ -b /dev/block/by-name/system_b ] || [ -b /dev/block/mapper/system_b ]; then
    HAS_SLOT_B=1
fi
if [ -b /dev/block/by-name/system ] || [ -b /dev/block/mapper/system ]; then
    HAS_SYSTEM_PLAIN=1
fi

# Strict multi-factor topology check
if [ "$HAS_SLOT_A" -eq 1 ] || [ "$HAS_SLOT_B" -eq 1 ]; then
    # A/B topology detected on disk
    if [ -z "$SLOT" ]; then
        ui_print "[-] ERROR: A/B partition topology detected, but bootloader provided no active slot suffix!"
        ui_print "    Refusing to guess active slot. Aborting before modifying storage."
        exit 1
    fi
    SYS_BLOCK="/dev/block/mapper/system${SLOT}"
    ui_print "  Topology: Verified Slot-based A/B Dynamic Partitions (Target: $SYS_BLOCK)"
elif [ "$HAS_SYSTEM_PLAIN" -eq 1 ]; then
    # Single-slot topology detected on disk
    if [ -n "$SLOT" ]; then
        ui_print "[-] ERROR: Contradictory topology! Single-slot layout on disk, but bootloader reported slot '$SLOT'!"
        ui_print "    Aborting before modifying storage."
        exit 1
    fi
    SYS_BLOCK="/dev/block/mapper/system"
    ui_print "  Topology: Verified Single-slot A-only Dynamic Partitions (Target: $SYS_BLOCK)"
else
    ui_print "[-] ERROR: No recognizable system partition found in device-mapper or by-name table!"
    exit 1
fi

# 3. Verify that the dynamic logical partition is actively mapped by TWRP
if [ ! -b "$SYS_BLOCK" ]; then
    ui_print "[-] ERROR: Logical system volume $SYS_BLOCK is not mapped in device-mapper!"
    ui_print "    In TWRP, dynamic partitions in $SUPER_DEV must be active before installation."
    ui_print "    Refusing to write to ambiguous or unmapped target."
    exit 1
fi
ui_print "[✓] Verified active logical system block device: $SYS_BLOCK"

# ------------------------------------------------------------------------------
# GATE 3: Pre-Flash Image Integrity, Format & Pinned Hash Verification
# ------------------------------------------------------------------------------
# 1. Existence of system.img in archive
if ! unzip -l "$ZIPFILE" system.img >/dev/null 2>&1; then
    ui_print "[-] ERROR: Payload entry 'system.img' not found inside $ZIPFILE!"
    exit 1
fi

# 2. Archive CRC32 verification
ui_print "- Testing ZIP archive integrity (CRC32)..."
if ! unzip -t "$ZIPFILE" system.img >/dev/null 2>&1; then
    ui_print "[-] ERROR: system.img archive verification failed! ZIP archive corrupted."
    exit 1
fi
ui_print "[✓] Archive integrity verified (CRC32 valid)."

# 3. Pinned SHA-256 identity verification of system.img against approved manifest
# Uses FIFO named pipe to ensure independent exit-code verification for BOTH unzip and sha256sum
ui_print "- Verifying system.img identity against pinned release SHA-256..."
FIFO_PATH="/tmp/sha_fifo.$$"
SHA_TMP="/tmp/sys_sha.$$"
rm -f "$FIFO_PATH" "$SHA_TMP"

clean_fifo_trap() {
    rm -f "$FIFO_PATH" "$SHA_TMP" 2>/dev/null || true
    if [ -n "${SHA_PID:-}" ]; then
        kill "$SHA_PID" 2>/dev/null || true
    fi
}
trap clean_fifo_trap EXIT HUP INT TERM

if ! mkfifo "$FIFO_PATH" 2>/dev/null; then
    ui_print "[-] ERROR: Failed to create temporary FIFO named pipe at $FIFO_PATH!"
    rm -f "$SHA_TMP"
    exit 1
fi

sha256sum < "$FIFO_PATH" > "$SHA_TMP" 2>/dev/null &
SHA_PID=$!

UNZIP_OK=1
if ! unzip -p "$ZIPFILE" system.img > "$FIFO_PATH" 2>/dev/null; then
    UNZIP_OK=0
fi

wait "$SHA_PID" 2>/dev/null
SHA_STATUS=$?
rm -f "$FIFO_PATH"

if [ "$UNZIP_OK" -ne 1 ]; then
    ui_print "[-] ERROR: Streaming system.img from ZIP archive failed!"
    rm -f "$SHA_TMP"
    exit 1
fi

if [ "$SHA_STATUS" -ne 0 ]; then
    ui_print "[-] ERROR: sha256sum calculation failed with status $SHA_STATUS!"
    rm -f "$SHA_TMP"
    exit 1
fi

ACTUAL_SHA256=$(awk '{print $1}' "$SHA_TMP" 2>/dev/null || echo "")
rm -f "$SHA_TMP"

if [ -z "$ACTUAL_SHA256" ] || [ "${#ACTUAL_SHA256}" -ne 64 ]; then
    ui_print "[-] ERROR: Failed to compute valid 64-character SHA-256 digest from stream!"
    exit 1
fi

ui_print "  Computed SHA-256: $ACTUAL_SHA256"
ui_print "  Approved SHA-256: $EXPECTED_SHA256"

if [ "$ACTUAL_SHA256" != "$EXPECTED_SHA256" ]; then
    ui_print "[-] ERROR: SHA-256 MISMATCH! Image differs from approved release artifact."
    ui_print "    Aborting before modifying physical eMMC storage."
    exit 1
fi
ui_print "[✓] Image identity verified against pinned SHA-256 manifest."

# 3. Capacity verification of the exact target block device
PART_SIZE=$(blockdev --getsize64 "$SYS_BLOCK" 2>/dev/null || echo 0)
ui_print "  Target blockdev size: $PART_SIZE bytes (Required: $MIN_REQUIRED_BYTES bytes)"

if [ "$PART_SIZE" -lt "$MIN_REQUIRED_BYTES" ]; then
    ui_print "[-] ERROR: System partition is too small ($PART_SIZE < $MIN_REQUIRED_BYTES)!"
    ui_print "    Aborting before modifying physical eMMC storage."
    exit 1
fi
ui_print "[✓] Partition capacity check PASSED."
set_progress 0.25

# ------------------------------------------------------------------------------
# STEP 4: Stream System Image to Block Device with Re-verification
# ------------------------------------------------------------------------------
# Final sanity check: confirm device node is still active immediately prior to write
if [ ! -b "$SYS_BLOCK" ]; then
    ui_print "[-] FATAL: Target device $SYS_BLOCK disappeared immediately prior to write!"
    exit 1
fi

ui_print "- Streaming Android 13 system image to $SYS_BLOCK..."
ui_print "  Please wait, this will take approximately 60-90 seconds..."

# Use dd with sync to flush write buffer
if ! unzip -p "$ZIPFILE" system.img | dd of="$SYS_BLOCK" bs=4M conv=fsync 2>/dev/null; then
    ui_print "[-] ERROR: Flashing system.img failed during write!"
    ui_print "    EMERGENCY UNBRICK: Flash original output_images/recovery_stock.img"
    ui_print "    or reflash OEM 8667.bin from a FAT32 USB flash drive."
    exit 1
fi
sync

ui_print "[✓] System image flashed and synced to disk."
set_progress 0.70

# ------------------------------------------------------------------------------
# STEP 5: Mount System & Inject Hardened Automotive Bridges
# ------------------------------------------------------------------------------
ui_print "- Mounting Android 13 system to configure automotive integration..."
mkdir -p /tmp/sys_mnt
if ! mount -t ext4 -o rw "$SYS_BLOCK" /tmp/sys_mnt 2>/dev/null; then
    mount -o rw "$SYS_BLOCK" /tmp/sys_mnt 2>/dev/null || true
fi

TARGET_BIN="/tmp/sys_mnt/system/bin"
TARGET_INIT="/tmp/sys_mnt/system/etc/init"
TARGET_PROP="/tmp/sys_mnt/system/build.prop"

if [ ! -d "$TARGET_BIN" ]; then
    TARGET_BIN="/tmp/sys_mnt/bin"
    TARGET_INIT="/tmp/sys_mnt/etc/init"
    TARGET_PROP="/tmp/sys_mnt/build.prop"
fi

if [ -d "$TARGET_BIN" ]; then
    ui_print "- Installing native automotive hardware daemons..."
    unzip -o "$ZIPFILE" 'bridge/*' -d /tmp/ >/dev/null 2>&1 || true

    cp /tmp/bridge/ts_mcu_daemon "$TARGET_BIN/" 2>/dev/null || true
    cp /tmp/bridge/bd3702_init "$TARGET_BIN/" 2>/dev/null || true
    cp /tmp/bridge/fan_governor "$TARGET_BIN/" 2>/dev/null || true
    cp /tmp/bridge/ts_automotive_init.sh "$TARGET_BIN/" 2>/dev/null || true

    chmod 755 "$TARGET_BIN/ts_mcu_daemon" 2>/dev/null || true
    chmod 755 "$TARGET_BIN/bd3702_init" 2>/dev/null || true
    chmod 755 "$TARGET_BIN/fan_governor" 2>/dev/null || true
    chmod 755 "$TARGET_BIN/ts_automotive_init.sh" 2>/dev/null || true

    if [ -d "$TARGET_INIT" ]; then
        cp /tmp/bridge/ts_automotive.rc "$TARGET_INIT/" 2>/dev/null || true
        chmod 644 "$TARGET_INIT/ts_automotive.rc" 2>/dev/null || true
    fi

    # TrebleDroid auto-run hook
    PHH_SCRIPT="$TARGET_BIN/phh-on-boot.sh"
    if [ -f "$PHH_SCRIPT" ]; then
        if ! grep -q "ts_automotive_init.sh" "$PHH_SCRIPT"; then
            echo "" >> "$PHH_SCRIPT"
            echo "# Topway TS8667 Automotive Bridge Auto-Start" >> "$PHH_SCRIPT"
            echo "if [ -x /system/bin/ts_automotive_init.sh ]; then" >> "$PHH_SCRIPT"
            echo "    /system/bin/ts_automotive_init.sh &" >> "$PHH_SCRIPT"
            echo "fi" >> "$PHH_SCRIPT"
        fi
    fi

    # Enforce landscape display orientation
    if [ -f "$TARGET_PROP" ]; then
        if ! grep -q "ro.sf.hwrotation" "$TARGET_PROP"; then
            echo "ro.sf.hwrotation=0" >> "$TARGET_PROP"
            echo "debug.sf.latch_unsignaled=1" >> "$TARGET_PROP"
            echo "ro.sf.lcd_density=192" >> "$TARGET_PROP"
        fi
    fi
    ui_print "[✓] Automotive hardware bridges injected cleanly."
else
    ui_print "! Warning: Could not locate /system/bin in mounted image."
fi

set_progress 0.90

# Clean unmount
sync
umount /tmp/sys_mnt 2>/dev/null || true
rm -rf /tmp/bridge /tmp/sys_mnt 2>/dev/null || true

set_progress 1.00

ui_print "====================================================="
ui_print " [✓] Android 13 AOSP Custom ROM Flashed Cleanly!     "
ui_print "====================================================="
ui_print "MANDATORY NEXT STEPS:"
ui_print "1. In TWRP, go to: Wipe -> Format Data (type 'yes')."
ui_print "2. Select: Reboot System."
ui_print "====================================================="

exit 0
